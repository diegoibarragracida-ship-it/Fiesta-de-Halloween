PORT=3000
ADMIN_PASSWORD=cambia-esta-clave
SESSION_SECRET=cambia-este-secreto-tambien
BASE_URL=http://localhost:3000

# Pega aquí el connection string de tu clúster de MongoDB Atlas
# (el mismo que usas en tus otros proyectos, ej. "profecionalesatuangel").
# Usa un nombre de base de datos distinto al final de la URL (aquí
# "halloween-invite") para no mezclar colecciones con tus otros proyectos.
# La colección que usa esta app se llama "halloween_guests".
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/halloween-invite
