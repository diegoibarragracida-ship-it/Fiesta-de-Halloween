      <div class="cd-box"><div class="num" id="cd-hours">--</div><div class="lbl">Horas</div></div>
      <div class="cd-box"><div class="num" id="cd-mins">--</div><div class="lbl">Min</div></div>
      <div class="cd-box"><div class="num" id="cd-secs">--</div><div class="lbl">Seg</div></div>
    </div>
  </div>

  <div class="card rsvp" id="rsvp-card">
    <div class="lottie-corner">
      <lottie-player src="https://assets4.lottiefiles.com/packages/lf20_xvpl2ws5.json" background="transparent" speed="1" loop autoplay></lottie-player>
    </div>
    <% if (submitted || guest.estado !== 'pendiente') { %>
      <h2>Confirma tu Asistencia</h2>
      <div class="confirm">
        <div class="icon">
          <%= guest.estado === 'confirmado' ? '🦇' : '☠️' %>
        </div>
        <h3>
          <%= guest.estado === 'confirmado' ? '¡Confirmado!' : 'Registrado que no podrás venir' %>
        </h3>
        <p>
          <% if (guest.estado === 'confirmado') { %>
            Nos vemos <%= guest.nombre %>, asistirán <%= guest.pases_confirmados %> de <%= guest.pases_asignados %> pase(s). ¡No olvides el disfraz!
          <% } else { %>
            Tu ausencia se sentirá en el aquelarre, <%= guest.nombre %>. ¡Será en otra ocasión!
          <% } %>
        </p>
        <span class="again" onclick="document.getElementById('rsvp-again').style.display='block'; this.style.display='none';">¿Necesitas cambiar tu respuesta?</span>
      </div>

      <div id="rsvp-again" style="display:none; margin-top:20px;">
        <form id="rsvp-form" method="POST" action="/invite/<%= guest.code %>/rsvp">
          <div class="field">
            <label>¿Asistirás?</label>
            <div class="choices">
              <button type="button" class="choice-btn" data-value="confirmado">🎃 Sí asistiré</button>
              <button type="button" class="choice-btn" data-value="no-asiste">☠️ No asistiré</button>
            </div>
            <input type="hidden" name="estado" id="estado-input" required>
          </div>
          <div class="field" id="guests-field">
            <label>¿Cuántos pases usarás? (máx. <%= guest.pases_asignados %>)</label>
            <div class="stepper">
              <button type="button" id="dec">−</button>
              <span id="guests-count">1</span>
              <button type="button" id="inc">+</button>
            </div>
            <input type="hidden" name="pases_confirmados" id="pases-input" value="1">
          </div>
          <div class="field">
            <label>Mensaje</label>
            <textarea name="mensaje" placeholder="Iré disfrazado de..."><%= guest.mensaje %></textarea>
          </div>
          <button type="submit" class="submit-btn">Actualizar respuesta</button>
        </form>
      </div>
    <% } else { %>
      <h2>Confirma tu Asistencia</h2>
      <p class="sub">Las almas perdidas también deben confirmar 💀</p>
      <form id="rsvp-form" method="POST" action="/invite/<%= guest.code %>/rsvp">
        <div class="field">
          <label>¿Asistirás?</label>
          <div class="choices">
            <button type="button" class="choice-btn" data-value="confirmado">🎃 Sí asistiré</button>
            <button type="button" class="choice-btn" data-value="no-asiste">☠️ No asistiré</button>
          </div>
          <input type="hidden" name="estado" id="estado-input" required>
        </div>
        <div class="field" id="guests-field">
          <label>¿Cuántos pases usarás? (máx. <%= guest.pases_asignados %>)</label>
          <div class="stepper">
            <button type="button" id="dec">−</button>
            <span id="guests-count">1</span>
            <button type="button" id="inc">+</button>
          </div>
          <input type="hidden" name="pases_confirmados" id="pases-input" value="1">
        </div>
        <div class="field">
          <label>Mensaje</label>
          <textarea name="mensaje" placeholder="Iré disfrazado de..."></textarea>
        </div>
        <button type="submit" class="submit-btn">Confirmar asistencia</button>
      </form>
    <% } %>
  </div>

  <footer>🪦 R.I.P. mis 20's · bienvenidos los 30 🪦</footer>
</div>

</div>

<script>
  // ---------- Pantalla de entrada ----------
  document.documentElement.classList.add('locked');
  document.getElementById('entry-tombstone-btn')?.addEventListener('click', function(){
    this.classList.remove('shake'); void this.offsetWidth; this.classList.add('shake');
    const music = document.getElementById('party-music');
    if (music) { music.play().catch(()=>{ /* el navegador bloqueó el autoplay, el usuario puede darle play manual */ }); }
    setTimeout(()=>{
      document.getElementById('entry-screen').classList.add('hidden');
      document.getElementById('main-content').classList.add('revealed');
      document.documentElement.classList.remove('locked');
      window.scrollTo({ top:0, behavior:'instant' });
      strikeLightning();
      scheduleLightning();
    }, 280);
  });

  const sky = document.getElementById('sky');
  for(let i=0;i<50;i++){
    const s = document.createElement('div');
    s.className='star'; s.style.top=Math.random()*100+'vh'; s.style.left=Math.random()*100+'vw';
    s.style.animationDelay=(Math.random()*3.5)+'s'; sky.appendChild(s);
  }
  for(let i=0;i<5;i++){
    const b = document.createElement('div');
    b.className='bat'; b.textContent='🦇'; b.style.top=(5+Math.random()*40)+'vh';
    b.style.animationDuration=(14+Math.random()*10)+'s'; b.style.animationDelay=(Math.random()*8)+'s';
    sky.appendChild(b);
  }

  document.getElementById('pumpkin')?.addEventListener('click', function(){
    this.style.transform='scale(1.15) rotate(6deg)';
    setTimeout(()=>{ this.style.transform=''; }, 220);
  });

  // ---------- Lápida como botón de entrada al RSVP ----------
  document.getElementById('tombstone-btn')?.addEventListener('click', function(){
    this.classList.remove('shake'); void this.offsetWidth; this.classList.add('shake');
    const target = document.getElementById('rsvp-card');
    if(target){ target.scrollIntoView({ behavior:'smooth', block:'center' }); }
  });

  // ---------- Truenos y relámpagos ----------
  function strikeLightning(){
    const flash = document.getElementById('lightning');
    const bolt = document.getElementById('thunder-bolt');
    bolt.style.right = (5 + Math.random()*70) + '%';
    flash.classList.remove('active'); void flash.offsetWidth; flash.classList.add('active');
    bolt.classList.remove('active'); void bolt.offsetWidth; bolt.classList.add('active');
  }
  function scheduleLightning(){
    const delay = 5000 + Math.random()*6000; // entre 5 y 11 segundos
    setTimeout(()=>{ strikeLightning(); scheduleLightning(); }, delay);
  }

  const eventDate = new Date('<%= event.fechaISO %>');
  function updateCountdown(){
    const now = new Date();
    let diff = eventDate - now;
    if(diff < 0) diff = 0;
    const d = Math.floor(diff/(1000*60*60*24));
    const h = Math.floor((diff/(1000*60*60))%24);
    const m = Math.floor((diff/(1000*60))%60);
    const s = Math.floor((diff/1000)%60);
    document.getElementById('cd-days').textContent = String(d).padStart(2,'0');
    document.getElementById('cd-hours').textContent = String(h).padStart(2,'0');
    document.getElementById('cd-mins').textContent = String(m).padStart(2,'0');
    document.getElementById('cd-secs').textContent = String(s).padStart(2,'0');
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);

  const maxPases = <%= guest.pases_asignados %>;
  let guests = 1;
  document.querySelectorAll('.choice-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('.choice-btn').forEach(b=>b.classList.remove('active','no'));
      btn.classList.add('active');
      if(btn.dataset.value==='no-asiste') btn.classList.add('no');
      document.getElementById('estado-input').value = btn.dataset.value;
      const guestsField = btn.closest('form').querySelector('#guests-field');
      guestsField.style.display = btn.dataset.value === 'no-asiste' ? 'none' : 'block';
    });
  });
  document.querySelectorAll('#inc').forEach(b=> b.addEventListener('click', ()=>{
    guests = Math.min(guests+1, maxPases);
    document.querySelectorAll('#guests-count').forEach(el=> el.textContent = guests);
    document.querySelectorAll('#pases-input').forEach(el=> el.value = guests);
  }));
  document.querySelectorAll('#dec').forEach(b=> b.addEventListener('click', ()=>{
    guests = Math.max(guests-1, 1);
    document.querySelectorAll('#guests-count').forEach(el=> el.textContent = guests);
    document.querySelectorAll('#pases-input').forEach(el=> el.value = guests);
  }));

  document.querySelectorAll('#rsvp-form').forEach(f=>{
    f.addEventListener('submit', function(e){
      if(!document.getElementById('estado-input').value){
        e.preventDefault();
        alert('Elige si asistirás o no 🎃');
      }
    });
  });
</script>
</body>
</html>
