<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= event.tituloEvento %> — Invitación de <%= guest.nombre %></title>
<link href="https://fonts.googleapis.com/css2?family=Creepster&family=Nosifer&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
<style>
  :root{
    --bg-void:#0a0611; --bg-deep:#170b26; --bg-panel:#1f0f30;
    --pumpkin:#ff7a1a; --pumpkin-glow:#ffb347; --slime:#6bff6b;
    --blood:#8c1620; --blood-bright:#d81f2f; --bone:#f3ead9; --bone-dim:#cfc3ae;
  }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; }
  body{
    background: radial-gradient(ellipse at 50% -10%, #2a1440 0%, var(--bg-deep) 45%, var(--bg-void) 100%);
    color:var(--bone); font-family:'Nunito',sans-serif; overflow-x:hidden; position:relative; min-height:100vh;
  }
  @media (prefers-reduced-motion: reduce){ *{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; } }

  .sky{ position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
  .star{ position:absolute; width:2px; height:2px; background:var(--bone); border-radius:50%; opacity:.5; animation:twinkle 3.5s ease-in-out infinite; }
  @keyframes twinkle{ 0%,100%{opacity:.15;} 50%{opacity:.9;} }
  .moon{
    position:absolute; top:4%; right:8%; width:110px; height:110px; border-radius:50%;
    background: radial-gradient(circle at 35% 35%, #fff7dd, var(--pumpkin-glow) 70%, #b5771f 100%);
    box-shadow: 0 0 60px 20px rgba(255,179,71,0.35), 0 0 140px 50px rgba(255,122,26,0.12);
  }
  .bat{ position:absolute; font-size:20px; animation:fly linear infinite; opacity:.85; }
  @keyframes fly{
    0%{ transform:translate(-10vw,10vh) scale(0.8) rotate(0deg); }
    50%{ transform:translate(55vw,-4vh) scale(1.1) rotate(-6deg); }
    100%{ transform:translate(120vw,14vh) scale(0.9) rotate(3deg); }
  }

  /* ---------- Lobo aullando junto a la luna ---------- */
  .wolf-moon{ position:absolute; top:10%; right:4%; width:130px; opacity:.95; filter:drop-shadow(0 0 14px rgba(0,0,0,0.7)); animation: wolf-sway 6s ease-in-out infinite; transform-origin:bottom center; }
  @keyframes wolf-sway{ 0%,100%{ transform:translateY(0) rotate(0deg);} 50%{ transform:translateY(-4px) rotate(-1.5deg);} }

  /* ---------- Ojos que acechan entre la niebla ---------- */
  .eyes-lurk{ position:fixed; z-index:2; pointer-events:none; animation:eyes-blink 4.5s ease-in-out infinite; }
  @keyframes eyes-blink{ 0%,84%,100%{ opacity:0;} 87%,95%{ opacity:1;} }

  /* ---------- Lobos feroces merodeando ---------- */
  .wolf-run{ position:fixed; bottom:2%; z-index:2; pointer-events:none; opacity:.92; animation: prowl linear infinite; filter:drop-shadow(0 4px 6px rgba(0,0,0,0.5)); }
  @keyframes prowl{
    0%{ transform:translate(-20vw,0) scaleX(1); }
    46%{ transform:translate(48vw,-1vh) scaleX(1); }
    50%{ transform:translate(52vw,-1vh) scaleX(-1); }
    100%{ transform:translate(120vw,0) scaleX(-1); }
  }

  /* ---------- Sangre goteando ---------- */
  .blood-drip{ position:fixed; top:0; z-index:2; pointer-events:none; opacity:.9; animation: drip-pulse 5s ease-in-out infinite; }
  @keyframes drip-pulse{ 0%,100%{ transform:scaleY(1); opacity:.85;} 50%{ transform:scaleY(1.12); opacity:1;} }

  .claw-marks{ position:absolute; z-index:1; pointer-events:none; opacity:.5; }

  .lightning{
    position:fixed; inset:0; z-index:3; pointer-events:none;
    background: #f3ead9; opacity:0;
  }
  @keyframes strike{
    0%{ opacity:0; }
    2%{ opacity:.85; }
    4%{ opacity:.1; }
    6%{ opacity:.6; }
    8%{ opacity:0; }
    100%{ opacity:0; }
  }
  .lightning.active{ animation: strike 900ms ease-out; }

  .thunder-bolt{
    position:fixed; z-index:3; pointer-events:none; opacity:0; top:0;
  }
  @keyframes boltFlash{
    0%{ opacity:0; }
    3%{ opacity:1; }
    6%{ opacity:0; }
    9%{ opacity:.8; }
    12%{ opacity:0; }
    100%{ opacity:0; }
  }
  .thunder-bolt.active{ animation: boltFlash 900ms ease-out; }
  .fog{
    position:fixed; bottom:0; left:0; width:200%; height:120px; z-index:1; pointer-events:none;
    background: linear-gradient(180deg, transparent, rgba(23,11,38,0.85));
    opacity:.8;
  }
  .fog-layer{
    position:fixed; bottom:-20px; width:220%; height:90px; z-index:1; pointer-events:none; opacity:.35;
    background: radial-gradient(ellipse at center, rgba(243,234,217,0.25), transparent 70%);
    animation: drift 30s linear infinite;
  }
  @keyframes drift{ from{ transform:translateX(0);} to{ transform:translateX(-20%);} }

  .web{ position:fixed; width:170px; height:170px; z-index:1; pointer-events:none; stroke:rgba(243,234,217,0.18); stroke-width:1; fill:none; }
  .web.tl{ top:-10px; left:-10px; }
  .web.tr{ top:-10px; right:-10px; transform:scaleX(-1); }

  .spider{ position:fixed; top:-40px; z-index:2; pointer-events:none; animation:dangle 5s ease-in-out infinite; }
  .spider .thread{ width:1px; background:rgba(243,234,217,0.18); margin:0 auto; }
  @keyframes dangle{ 0%,100%{ transform:rotate(-8deg);} 50%{ transform:rotate(8deg);} }

  .ghost{ position:fixed; z-index:1; pointer-events:none; opacity:.9; animation:float 7s ease-in-out infinite; filter:drop-shadow(0 0 12px rgba(255,255,255,0.15)); }
  @keyframes float{ 0%,100%{ transform:translateY(0) translateX(0);} 50%{ transform:translateY(-24px) translateX(10px);} }

  .cat{ position:fixed; z-index:2; pointer-events:none; opacity:.9; }

  .candy-border{
    position:relative; height:14px; z-index:2;
    background: repeating-linear-gradient(135deg, #ff7a1a 0 10px, #f3ead9 10px 20px, #8c1620 20px 30px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.4);
  }

  .wrap{ position:relative; z-index:5; max-width:780px; margin:0 auto; padding:0 20px 120px; }

  .hero{ text-align:center; padding:68px 0 14px; position:relative; }
  .eyebrow{ letter-spacing:.35em; text-transform:uppercase; font-size:13px; color:var(--slime); font-weight:800; margin-bottom:14px; }
  h1.title{
    font-family:'Creepster',cursive; font-weight:400; font-size:clamp(54px,13vw,96px); line-height:1; margin:0 0 12px;
    color:var(--pumpkin); text-shadow:0 0 10px rgba(255,122,26,0.6), 0 0 32px rgba(255,122,26,0.35), 3px 3px 0 #4a0e12;
    animation: flicker 4s infinite;
  }
  @keyframes flicker{ 0%,19%,21%,23%,54%,56%,100%{opacity:1;} 20%,22%,55%{opacity:.78;} }
  .subtitle{ font-size:17px; color:var(--bone-dim); max-width:520px; margin:0 auto 10px; line-height:1.5; }
  .host-line{ font-size:14px; color:var(--pumpkin-glow); font-weight:800; margin-bottom:26px; }

  .guest-banner{
    background: linear-gradient(135deg, rgba(255,122,26,0.15), rgba(140,22,32,0.15));
    border:1px solid rgba(255,122,26,0.35); border-radius:14px; padding:22px 24px; text-align:center; margin:0 0 30px;
  }
  .guest-banner .hi{ font-size:13px; color:var(--bone-dim); text-transform:uppercase; letter-spacing:.08em; }
  .guest-banner .name{ font-family:'Nosifer',cursive; font-size:20px; color:var(--bone); margin:6px 0; }
  .guest-banner .passes{ font-size:14px; color:var(--slime); font-weight:800; }

  .decor-row{ display:flex; justify-content:center; align-items:flex-end; gap:20px; margin:10px 0 32px; }
  .decor-row svg{ display:block; }

  .tombstone-wrap{ display:flex; justify-content:center; margin:6px 0 4px; }
  .tombstone-btn{
    background:none; border:none; padding:0; cursor:pointer;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5));
    transition: transform .2s ease, filter .2s ease;
    animation: tombstone-pulse 3s ease-in-out infinite;
  }
  .tombstone-btn:hover{
    transform: translateY(-4px) scale(1.03);
    filter: drop-shadow(0 16px 28px rgba(0,0,0,0.6)) drop-shadow(0 0 18px rgba(255,122,26,0.35));
  }
  .tombstone-btn:active{ transform: translateY(2px) scale(0.97) rotate(-1deg); }
  @keyframes tombstone-pulse{
    0%,100%{ filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5)); }
    50%{ filter: drop-shadow(0 10px 20px rgba(0,0,0,0.5)) drop-shadow(0 0 14px rgba(255,122,26,0.25)); }
  }
  .tombstone-btn.shake{ animation: tombstone-shake .5s ease; }
  @keyframes tombstone-shake{
    0%,100%{ transform: translateX(0); }
    20%{ transform: translateX(-6px) rotate(-2deg); }
    40%{ transform: translateX(6px) rotate(2deg); }
    60%{ transform: translateX(-4px) rotate(-1deg); }
    80%{ transform: translateX(4px) rotate(1deg); }
  }
  .tombstone-cta{
    text-align:center; font-size:11px; letter-spacing:.1em; text-transform:uppercase;
    color: var(--pumpkin-glow); font-weight:800; margin:10px 0 0; opacity:.9;
    animation: cta-blink 2s ease-in-out infinite;
  }
  @keyframes cta-blink{ 0%,100%{ opacity:.5; } 50%{ opacity:1; } }
  .hint{ text-align:center; font-size:12px; color:var(--bone-dim); opacity:.7; margin:8px 0 26px; }

  .card{
    background: linear-gradient(180deg, var(--bg-panel), #150a24);
    border:1px solid rgba(255,122,26,0.25); border-radius:18px; padding:34px 26px; margin:34px 0;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), inset 0 0 40px rgba(140,22,32,0.08);
    position:relative;
  }
  .card::before{ content:'🕸️'; position:absolute; top:-16px; left:-10px; font-size:26px; transform:rotate(-15deg); }
  .card::after{ content:'🕸️'; position:absolute; bottom:-16px; right:-10px; font-size:26px; transform:rotate(165deg); }
  .card h2{ font-family:'Nosifer',cursive; font-weight:400; font-size:22px; color:var(--blood-bright); margin:0 0 18px; text-align:center; text-shadow:0 0 8px rgba(216,31,47,0.5); }

  .details-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .detail{ background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:14px 16px; }
  .detail .label{ font-size:11px; text-transform:uppercase; letter-spacing:.12em; color:var(--slime); font-weight:800; }
  .detail .value{ font-size:15px; margin-top:4px; font-weight:700; color:var(--bone); }
  @media (max-width:480px){ .details-grid{ grid-template-columns:1fr; } }

  .map-btn{
    display:block; text-align:center; margin-top:16px; text-decoration:none;
    background:linear-gradient(180deg,#3a6b3a,#254a25); color:var(--bone); font-weight:800; font-size:14px;
    padding:13px; border-radius:10px;
  }
  .map-btn:hover{ filter:brightness(1.1); }

  .costume-notice{
    margin-top:20px; padding:14px 16px; border-radius:12px;
    background:rgba(216,31,47,0.1); border:1px solid rgba(216,31,47,0.35); text-align:center; font-size:14px; color:var(--bone);
  }
  .costume-notice strong{ color:var(--pumpkin-glow); }

  .countdown{ display:flex; justify-content:center; gap:14px; margin:30px 0 6px; flex-wrap:wrap; }
  .cd-box{
    background: radial-gradient(circle at 50% 0%, #2a0e12, #150609);
    border:1px solid rgba(216,31,47,0.4); border-radius:12px; width:84px; padding:16px 0; text-align:center;
    box-shadow:0 0 18px rgba(140,22,32,0.35);
  }
  .cd-box .num{ font-size:30px; font-weight:800; color:var(--pumpkin-glow); font-variant-numeric:tabular-nums; }
  .cd-box .lbl{ font-size:10px; text-transform:uppercase; letter-spacing:.1em; color:var(--bone-dim); margin-top:2px; }

  .rsvp .sub{ text-align:center; color:var(--bone-dim); font-size:13px; margin-bottom:22px; }
  form{ display:flex; flex-direction:column; gap:16px; }
  .field label{ display:block; font-size:12px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--slime); margin-bottom:6px; }
  .field input[type=text], .field textarea{
    width:100%; padding:12px 14px; border-radius:10px; background:rgba(0,0,0,0.35);
    border:1px solid rgba(255,255,255,0.12); color:var(--bone); font-size:14px;
  }
  .field textarea{ resize:vertical; min-height:70px; }

  .choices{ display:flex; gap:10px; }
  .choice-btn{
    flex:1; padding:12px 8px; border-radius:10px; cursor:pointer; background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.12); color:var(--bone-dim); font-weight:700; font-size:13px; transition:all .15s ease;
  }
  .choice-btn:hover{ border-color:var(--pumpkin); }
  .choice-btn.active{ background:linear-gradient(180deg,var(--pumpkin),#c85a0a); color:#1a0700; border-color:var(--pumpkin); box-shadow:0 0 16px rgba(255,122,26,0.45); }
  .choice-btn.active.no{ background:linear-gradient(180deg,var(--blood-bright),var(--blood)); color:var(--bone); }

  .stepper{ display:flex; align-items:center; gap:14px; background:rgba(0,0,0,0.35); border:1px solid rgba(255,255,255,0.12); border-radius:10px; padding:8px 14px; width:fit-content; }
  .stepper button{ width:30px; height:30px; border-radius:50%; border:none; cursor:pointer; background:var(--pumpkin); color:#1a0700; font-weight:800; font-size:16px; }
  .stepper span{ min-width:60px; text-align:center; font-weight:800; }

  .submit-btn{
    margin-top:6px; padding:15px; border-radius:12px; border:none; cursor:pointer;
    background:linear-gradient(180deg,var(--blood-bright),var(--blood)); color:var(--bone);
    font-family:'Nosifer',cursive; font-weight:400; font-size:16px; letter-spacing:.04em; box-shadow:0 10px 30px rgba(140,22,32,0.45);
  }

  .confirm{ text-align:center; padding:10px 4px; }
  .confirm .icon{ font-size:44px; margin-bottom:10px; }
  .confirm h3{ font-family:'Creepster',cursive; font-weight:400; font-size:28px; color:var(--slime); margin:0 0 8px; }
  .confirm p{ color:var(--bone-dim); font-size:14px; margin:0 0 8px; }
  .confirm .again{ display:inline-block; margin-top:14px; color:var(--bone-dim); font-size:12px; text-decoration:underline; cursor:pointer; }

  footer{ text-align:center; margin-top:48px; color:var(--bone-dim); font-size:13px; opacity:.65; }

  /* ---------- Pantalla de entrada ---------- */
  html.locked, html.locked body{ overflow:hidden; height:100%; }
  .entry-screen{
    position:fixed; inset:0; z-index:50; display:flex; align-items:center; justify-content:center;
    flex-direction:column; text-align:center; padding:24px;
    background: radial-gradient(ellipse at 50% 20%, #2a1440 0%, var(--bg-deep) 45%, var(--bg-void) 100%);
    transition: opacity .6s ease, visibility .6s ease;
  }
  .entry-screen.hidden{ opacity:0; visibility:hidden; pointer-events:none; }
  .entry-eyebrow{ letter-spacing:.3em; text-transform:uppercase; font-size:12px; color:var(--slime); font-weight:800; margin-bottom:10px; }
  .entry-title{
    font-family:'Creepster',cursive; font-weight:400; font-size:clamp(42px,10vw,68px); line-height:1; margin:0 0 26px;
    color:var(--pumpkin); text-shadow:0 0 10px rgba(255,122,26,0.6), 0 0 32px rgba(255,122,26,0.35), 3px 3px 0 #4a0e12;
  }
  .entry-tombstone-btn{
    background:none; border:none; padding:0; cursor:pointer;
    filter: drop-shadow(0 14px 26px rgba(0,0,0,0.55));
    transition: transform .2s ease, filter .2s ease;
    animation: tombstone-pulse 3s ease-in-out infinite;
  }
  .entry-tombstone-btn:hover{ transform: translateY(-4px) scale(1.03); filter: drop-shadow(0 18px 32px rgba(0,0,0,0.6)) drop-shadow(0 0 22px rgba(255,122,26,0.4)); }
  .entry-tombstone-btn:active{ transform: translateY(2px) scale(0.97) rotate(-1deg); }
  .entry-tombstone-btn.shake{ animation: tombstone-shake .5s ease; }
  .entry-music{
    margin-top:18px;
    display:flex; flex-direction:column; align-items:center; gap:8px;
  }
  .entry-music-label{
    font-family:'Nunito',sans-serif; font-weight:800; font-size:13px;
    letter-spacing:.5px; color:#ff7a1a; text-shadow:0 0 10px rgba(255,122,26,0.5);
  }
  .entry-music audio{
    width:230px; max-width:70vw; height:34px; border-radius:20px;
    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.4));
  }
  .main-content{ opacity:0; transition: opacity .5s ease; }
  .main-content.revealed{ opacity:1; }

  #invitation-body{ position:relative; }

  /* ---------- Animaciones Lottie ---------- */
  .lottie-corner{ position:absolute; top:-22px; right:-14px; z-index:2; pointer-events:none; }
  .lottie-corner lottie-player{ width:96px; height:96px; }

  /* ---------- Ajustes para pantallas de celular ---------- */
  @media (max-width:480px){
    .wrap{ padding:0 16px 100px; }
    .card{ padding:26px 18px; margin:26px 0; }
    .web{ width:120px; height:120px; }
    .wolf-moon{ width:95px; top:14%; }
    .moon{ width:90px; height:90px; top:3%; }
    .cd-box{ width:70px; padding:12px 0; }
    .cd-box .num{ font-size:24px; }
    .countdown{ gap:10px; }
    h1.title{ font-size:clamp(44px,15vw,68px); }
    .entry-title{ font-size:clamp(36px,12vw,52px); }
    .lottie-corner{ top:-16px; right:-8px; }
    .lottie-corner lottie-player{ width:70px; height:70px; }
  }
  @media (max-width:360px){
    .decor-row{ gap:8px !important; }
  }
</style>
</head>
<body>

<div class="entry-screen" id="entry-screen">
  <div class="entry-eyebrow">Dulce, travesura… ¡y una noche para recordar!</div>
  <h1 class="entry-title"><%= event.tituloEvento %></h1>
  <svg width="64" height="80" viewBox="0 0 100 130" style="margin:-10px 0 18px; filter:drop-shadow(0 6px 10px rgba(0,0,0,0.5));">
    <ellipse cx="50" cy="122" rx="38" ry="6" fill="#000" opacity="0.25"/>
    <path d="M78 100 Q100 95 96 70 Q92 85 76 88 Z" fill="#0d0d0d"/>
    <path d="M20 118 Q8 100 16 78 Q10 60 22 46 Q34 55 34 70 L40 70 Q42 50 58 44 Q56 28 66 18 Q68 8 76 10 Q72 20 76 28 Q88 30 88 44 Q96 50 90 60 Q80 62 74 56 Q70 68 60 72 Q64 90 54 100 Q58 112 46 118 Q48 124 38 122 Q30 128 20 118Z" fill="#0d0d0d"/>
    <polygon points="66,18 58,0 76,10" fill="#0d0d0d"/>
    <polygon points="76,10 82,-6 90,8" fill="#0d0d0d"/>
    <circle cx="40" cy="52" r="2.8" fill="#ff2b2b"/>
  </svg>
  <button type="button" class="entry-tombstone-btn" id="entry-tombstone-btn" title="Toca para entrar" aria-label="Entrar a la invitación">
    <svg viewBox="0 0 200 220" width="210">
      <ellipse cx="100" cy="205" rx="90" ry="10" fill="#000" opacity="0.35"/>
      <path d="M20 210 V90 Q20 15 100 15 Q180 15 180 90 V210 Z" fill="#8a8a8a" stroke="#5c5c5c" stroke-width="3"/>
      <path d="M20 210 V90 Q20 15 100 15 Q180 15 180 90 V210 Z" fill="url(#stoneGrad2)" opacity="0.5"/>
      <defs><linearGradient id="stoneGrad2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#c9c9c9"/><stop offset="100%" stop-color="#6b6b6b"/></linearGradient></defs>
      <text x="100" y="60" text-anchor="middle" font-family="'Nosifer',cursive" font-size="30" fill="#2a2a2a">R.I.P.</text>
      <line x1="45" y1="75" x2="155" y2="75" stroke="#4a4a4a" stroke-width="2"/>
      <text x="100" y="102" text-anchor="middle" font-family="'Nunito',sans-serif" font-weight="800" font-size="15" fill="#333">AQUÍ YACEN</text>
      <text x="100" y="124" text-anchor="middle" font-family="'Nunito',sans-serif" font-weight="800" font-size="19" fill="#222">MIS 20's</text>
      <text x="100" y="148" text-anchor="middle" font-family="'Nunito',sans-serif" font-style="italic" font-size="12" fill="#444">Guadalupe R. Z.</text>
      <text x="100" y="172" text-anchor="middle" font-family="'Nunito',sans-serif" font-size="11" fill="#4a4a4a">"Fueron buenos años"</text>
      <path d="M35 170 q6 -14 12 0" stroke="#556b3a" stroke-width="2.5" fill="none"/>
      <path d="M150 175 q7 -16 14 0" stroke="#556b3a" stroke-width="2.5" fill="none"/>
    </svg>
  </button>
  <p class="tombstone-cta">👇 toca la lápida para entrar 👇</p>

  <div class="entry-music">
    <span class="entry-music-label">🎵 Monster Mash</span>
    <audio id="party-music" src="/audio/monster-mash.mp3" loop preload="none" controls></audio>
  </div>
</div>

<div class="main-content" id="main-content">

<div class="sky" id="sky">
  <div class="moon"></div>
  <svg class="wolf-moon" viewBox="0 0 100 130" width="130">
    <ellipse cx="50" cy="122" rx="38" ry="6" fill="#000" opacity="0.3"/>
    <path d="M78 100 Q100 95 96 70 Q92 85 76 88 Z" fill="#0a0a0a"/>
    <path d="M20 118 Q8 100 16 78 Q10 60 22 46 Q34 55 34 70 L40 70 Q42 50 58 44 Q56 28 66 18 Q68 8 76 10 Q72 20 76 28 Q88 30 88 44 Q96 50 90 60 Q80 62 74 56 Q70 68 60 72 Q64 90 54 100 Q58 112 46 118 Q48 124 38 122 Q30 128 20 118Z" fill="#0a0a0a"/>
    <polygon points="66,18 58,0 76,10" fill="#0a0a0a"/>
    <polygon points="76,10 82,-6 90,8" fill="#0a0a0a"/>
